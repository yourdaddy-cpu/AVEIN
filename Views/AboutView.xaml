<UserControl x:Class="AVEIN.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="About AVEIN" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12" />
        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16">
            AVEIN is a personal AI assistant built in C# with a local GGUF brain.
            It can chat, remember, search the web, create files, and eventually
            control the PC and automate YouTube uploads.
        </TextBlock>
        <TextBlock Text="Version 1.0" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>
</UserControl>

<UserControl x:Class="AVEIN.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Chat Message Area -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessageList" />
                </ScrollViewer>

                <!-- Top-right circular visual from sketch -->
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top"
                      Width="70" Height="70" Margin="0,14,14,0"
                      IsHitTestVisible="False" Opacity="0.55">
                    <Ellipse Width="70" Height="70">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#553B82F6" Offset="0.0" />
                                <GradientStop Color="#33A855F7" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="46" Height="46" Stroke="#66E8E3FF" StrokeThickness="1.2" />
                    <Ellipse Width="18" Height="18" Fill="Black" />
                </Grid>
            </Grid>
        </Border>

        <!-- Input Area -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Checkboxes and settings from sketch -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <CheckBox x:Name="DeepThinkToggle" Content="Deep thinking" Margin="0,0,16,0"
                          Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                <CheckBox x:Name="SpeakToggle" Content="Speak" Margin="0,0,16,0"
                          Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                <Button Content="⚙" Click="NewChatButton_Click" 
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}"
                        FontSize="16" Cursor="Hand" VerticalAlignment="Center" ToolTip="New Chat"/>
            </StackPanel>

            <!-- Main Input Box and Buttons -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,10,0">
                    <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                             Padding="12,10" FontSize="14" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             KeyDown="InputBox_KeyDown" />
                </Border>

                <Button x:Name="MicButton" Grid.Column="1" Content="Mic" Click="MicButton_Click"
                        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource SecondaryTextBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Padding="16,10" Margin="0,0,10,0" Cursor="Hand" />

                <Button Grid.Column="2" Content="Send" Click="SendButton_Click"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Padding="20,10" FontWeight="SemiBold" Cursor="Hand" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>

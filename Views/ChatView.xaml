<UserControl x:Class="AVEIN.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Chat" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

            <CheckBox x:Name="DeepThinkToggle" Grid.Column="1" Content="Deep Think"
                      VerticalAlignment="Center" Margin="0,0,10,0"
                      Foreground="{DynamicResource SecondaryTextBrush}" />

            <CheckBox x:Name="SpeakToggle" Grid.Column="2" Content="Speak replies"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      Foreground="{DynamicResource SecondaryTextBrush}" />

            <Button Grid.Column="3" Content="New Chat" Click="NewChatButton_Click"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="14,8" Margin="0,0,10,0" Cursor="Hand" />

            <ComboBox x:Name="ModelSelector" Grid.Column="4" Width="140" SelectedIndex="0">
                <ComboBoxItem Content="Phi4-mini" />
            </ComboBox>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessageList" />
                </ScrollViewer>

                <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Width="70" Height="70" Margin="0,0,14,14"
                      IsHitTestVisible="False" Opacity="0.55">
                    <Ellipse Width="70" Height="70">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#553B82F6" Offset="0.0" />
                                <GradientStop Color="#33A855F7" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="46" Height="46" Stroke="#66E8E3FF" StrokeThickness="1.2" />
                    <Ellipse Width="18" Height="18" Fill="Black" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,10,0">
                <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                         Padding="12,10" FontSize="14" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         KeyDown="InputBox_KeyDown" />
            </Border>

            <Button x:Name="MicButton" Grid.Column="1" Content="Mic" Click="MicButton_Click"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource SecondaryTextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="16,10" Margin="0,0,10,0" Cursor="Hand" />

            <Button Grid.Column="2" Content="Send" Click="SendButton_Click"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Padding="20,10" FontWeight="SemiBold" Cursor="Hand" />
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="AVEIN.Views.AvenDexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Aven Dex" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Your coding agent — reads, writes, and modifies project files"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="New Session" Click="NewSession_Click"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="14,8" Cursor="Hand" VerticalAlignment="Center" />
        </Grid>

        <!-- Project selector -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Project:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBox x:Name="ProjectPathBox" Grid.Column="1"
                         Padding="8,6" FontSize="12"
                         Background="{DynamicResource BackgroundBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         IsReadOnly="True"
                         Text="(no project selected — click Browse)" />

                <Button Grid.Column="2" Content="Browse" Click="BrowseProject_Click"
                        Margin="8,0,0,0" Padding="14,6"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- Chat area -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">
            <Grid>
                <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessageList" />
                </ScrollViewer>

                <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Width="70" Height="70" Margin="0,0,14,14"
                      IsHitTestVisible="False" Opacity="0.55">
                    <Ellipse Width="70" Height="70">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#553B82F6" Offset="0.0" />
                                <GradientStop Color="#33A855F7" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="46" Height="46" Stroke="#66E8E3FF" StrokeThickness="1.2" />
                    <Ellipse Width="18" Height="18" Fill="Black" />
                </Grid>
            </Grid>
        </Border>

        <!-- Input -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,10,0">
                <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                         Padding="12,10" FontSize="14" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         KeyDown="InputBox_KeyDown" />
            </Border>

            <Button Grid.Column="1" Content="Send" Click="SendButton_Click"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Padding="20,10" FontWeight="SemiBold" Cursor="Hand" />
        </Grid>
    </Grid>
</UserControl>

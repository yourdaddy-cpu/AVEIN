<Window x:Class="AVEIN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AVEIN.Views"
        Title="AVEIN" Height="650" Width="1000" MinHeight="480" MinWidth="760"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="0,0,0,16">

                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,24">
                    <TextBlock Text="AVEIN" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Personal AI Assistant" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="10,0">
                    <Button x:Name="NavChatButton" Content="Chat" Click="NavChatButton_Click"
                            Style="{StaticResource NavButtonActiveStyle}" Margin="0,0,0,4" />
                    <Button x:Name="NavMemoryButton" Content="Memory" Click="NavMemoryButton_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4" />
                    <Button x:Name="NavPluginsButton" Content="Plugins" Click="NavPluginsButton_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4" />
                    <Button x:Name="NavSettingsButton" Content="Settings" Click="NavSettingsButton_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="10,0">
                    <Button x:Name="NavAboutButton" Content="About" Click="NavAboutButton_Click"
                            Style="{StaticResource NavButtonStyle}" />
                    <TextBlock Text="v1.0" FontSize="10" Margin="16,10,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

            </DockPanel>
        </Border>

        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="24" />
    </Grid>
</Window>
